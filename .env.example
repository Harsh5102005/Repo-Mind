# RepoMind Environment Variables

# Required: Groq API key for LLM calls (get one at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# Optional: Local repository storage directory
REPOS_DIR=./repos

# Optional: Embedding model (sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: API host/port
API_HOST=0.0.0.0
API_PORT=8000

# Optional: CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173